{
    "name": "touhidurabir/laravel-presenter",
    "description": "A package that helps to group methods that mostly use for the view presentation purpose.",
    "type": "library",
    "license": "MIT",
    "autoload": {
        "psr-4": {
            "Touhidurabir\\Presenter\\": "src/"
        }
    },
    "autoload-dev" : {
        "psr-4" : {
            "Touhidurabir\\Presenter\\Tests\\": "tests/"
        }
    },
    "authors": [
        {
            "name": "Touhidur Rahman",
            "email": "abircse06@gmail.com"
        }
    ],
    "require-dev": {
        "phpunit/phpunit": "^9.5||^10.0||^11.0||^12.0",
        "orchestra/testbench": "^6.21||^7.0||^8.0||^9.0||^10.0||^11.0",
        "laravel/pint": "^1.0"
    },
    "require": {
        "php": ">=7.3",
        "touhidurabir/laravel-stub-generator": "^1.0",
        "illuminate/console": "^8.0||^9.0||^10.0||^11.0||^12.0||^13.0",
        "illuminate/container": "^8.0||^9.0||^10.0||^11.0||^12.0||^13.0",
        "illuminate/database": "^8.0||^9.0||^10.0||^11.0||^12.0||^13.0",
        "illuminate/support": "^8.0||^9.0||^10.0||^11.0||^12.0||^13.0"
    },
    "extra": {
        "laravel": {
            "providers": [
                "Touhidurabir\\Presenter\\PresenterServiceProvider"
            ]
        }
    },
    "scripts": {
        "format": "pint",
        "lint": "pint --test"
    }
}
